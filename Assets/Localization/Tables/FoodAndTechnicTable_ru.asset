    m_Metadata:
      m_Items: []
  - m_Id: 15960382458294272
    m_Localized: "\u041A\u0443\u0441\u043E\u043A \u043C\u0435\u0442\u0430\u043B\u043B\u0430
      \u0432 \u0444\u043E\u0440\u043C\u0435 \u0436\u0435\u043B\u0435. \u041D\u0430
      \u044D\u0442\u0443 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0443
      \u0431\u044B\u043B\u043E \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043E
      \u043E\u043A\u043E\u043B\u043E \u0434\u0432\u0443\u0445 \u043B\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 15960090023030784
    m_Localized: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u0430 \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0436\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15962051896143872
    m_Localized: "\u0422\u044B \u0431\u044B\u0442\u044C \u043C\u043E\u043B\u043E\u0434\u0435\u0446
      \u2014 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C \u043C\u0438\u0441\u043A\u0430
      \u0440\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 15961992353804288
    m_Localized: "\u0414\u043B\u044F \u0432\u0435\u0441\u0451\u043B\u043E\u0433\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15961866461769728
    m_Localized: "\u041D\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u044C
      (\u043D\u0430\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u043D\u0435
      \u043D\u0443\u0436\u043D\u044B)"
    m_Metadata:
      m_Items: []
  - m_Id: 15961159667019776
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u043E \u043E\u0434\u043D\u043E:
      \u043D\u0438 \u043F\u0440\u0438 \u043A\u0430\u043A\u0438\u0445 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u0432 \u043A\u0430\u043A\u043E\u0439
      \u0441\u0442\u0440\u0430\u043D\u0435 \u0435\u0433\u043E \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 15961480191537152
    m_Localized: "\u041D\u0435 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 15961510109507584
    m_Localized: "\u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0440\u0430\u0437\u0431\u0438\u0442\u044C
      \u043F\u0430\u0440\u0443 \u044F\u0438\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 15961448579067904
    m_Localized: "\u041D\u0430 110% \u043D\u0435 \u0438\u0437 \u043A\u0440\u0430\u0431\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 15961610294652928
    m_Localized: "\u0416\u0438\u0437\u043D\u044C \u043D\u0435 \u0434\u0430\u043B\u0430
      \u0442\u0435\u0431\u0435 \u043B\u0438\u043C\u043E\u043D\u043E\u0432, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043A\u0443\u043F\u0438 \u043B\u0438\u043C\u043E\u043D\u0430\u0434 \u0443
      \u043D\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 15961234149470208
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0438 \u0441 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435\u043C
      \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 15961698094018560
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u043D\u044B \u0438\u0437 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0445
      \u043A\u043E\u0441\u0442\u0435\u0439 \u0438 \u043F\u043E\u0434\u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430, \u0434\u0435\u0442\u0438\u0448\u043A\u0430\u043C
      \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15961810522337280
    m_Localized: "\u0425\u0432\u0430\u0442\u0438\u0442 \u043F\u0438\u0441\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0432 \u0440\u0435\u0446\u0435\u043F\u0442\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0438!
      \u0418 \u0432\u043E\u043E\u0431\u0449\u0435, \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435
      \u044D\u0442\u0430 \u0432\u0430\u0448\u0430 \"\u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0430\"?"
    m_Metadata:
      m_Items: []
  - m_Id: 15962306121297920
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C
      \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0433\u043E, \u0442\u043E \u043F\u0440\u043E\u0441\u044C\u0431\u0430
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u043D\u0430\u043C\u0438
      \u043F\u043E \u044D\u0442\u043E\u043C\u0443 \u043D\u043E\u043C\u0435\u0440\u0443:
      +7 (495) 445-55-25"
    m_Metadata:
      m_Items: []
  - m_Id: 15962453010018304
    m_Localized: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440
      \u0434\u043B\u044F \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0432
      \u044F\u0434\u0435\u0440\u043D\u043E\u043C \u0430\u043F\u043E\u043A\u0430\u043B\u0438\u043F\u0441\u0438\u0441\u0435
      \u0432\u0441\u0435\u0439 \u0441\u0435\u043C\u044C\u0451\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 15960729499201536
    m_Localized: "\u0414\u0443\u0448\u043D\u0435\u0435 \u043B\u044E\u0431\u043E\u0433\u043E
