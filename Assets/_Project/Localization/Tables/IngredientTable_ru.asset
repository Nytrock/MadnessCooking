  - m_Id: 15963599078420480
    m_Localized: "\u041F\u043E\u043C\u0438\u0434\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 15963629638119424
    m_Localized: "\u041F\u0448\u0435\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 15962750281314304
    m_Localized: "\u041D\u0435 \u043F\u0443\u0442\u0430\u0442\u044C \u0441 \u044F\u0433\u043E\u0434\u0430\u043C\u0438
      \u0446\u0432\u0435\u0442\u0430 \u043C\u0435\u0440\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0438\u043D\u0434\u0438\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 15962785735766016
    m_Localized: "\u0424\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u043E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 15962913997582336
    m_Localized: "\u0421\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E
      \u044D\u0442\u043E \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442 \u0416\u0435\u043D\u0435\u0432\u0441\u043A\u0443\u044E
      \u041A\u043E\u043D\u0432\u0435\u043D\u0446\u0438\u044E \u0438\u043B\u0438 \u0432\u0440\u043E\u0434\u0435
      \u0442\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 15963066632499200
    m_Localized: "\u041F\u0440\u0438 \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0438
      \u0432\u0451\u0434\u0440\u0430\u043C\u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0432\u0441\u0435 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435
      \u044D\u0444\u0444\u0435\u043A\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 15962951779872768
    m_Localized: "\u0418\u043D\u0432\u0430\u043B\u0438\u0434, \u0433\u0434\u0435
      \u043C\u043E\u0438 \u044F\u0439\u0446\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 15962979168677888
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u0442\u044C
      \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 15963037930876928
    m_Localized: "\u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439\u0442\u0435,
      \u0447\u044C\u0451 \u044D\u0442\u043E \u043C\u044F\u0441\u043E, \u043C\u044B
      \u0441\u0430\u043C\u0438 \u0431\u0435\u0437 \u043F\u043E\u043D\u044F\u0442\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 15963630908993536
    m_Localized: "\u0418\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u044F\u043D\u0435
      \u043B\u044E\u0431\u044F\u0442 \u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u044D\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 15963097305444352
    m_Localized: "\u0420\u0430\u0441\u0442\u0451\u0442 \u043D\u0435 \u043D\u0430
      \u043F\u0430\u043B\u044C\u043C\u0430\u0445 \u0438 \u043D\u0435 \u0432 \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u043D\u044B\u0445
      \u0431\u0430\u043D\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 15962833924124672
    m_Localized: "\u041C\u044B \u041D\u0415 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C
      \u0443\u043C\u043F\u0430-\u043B\u0443\u043C\u043F\u043E\u0432 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u0434\u0435\u0448\u0451\u0432\u043E\u0439 \u0440\u0430\u0431\u043E\u0447\u0435\u0439
      \u0441\u0438\u043B\u044B. \u0427\u0435\u0441\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 15963143497314304
    m_Localized: "\u041D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      \u0434\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043E\u0434\u043D\u043E\u0439
      \u0441\u0442\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 15963435865468928
    m_Localized: "\u041A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043D\u0430\u0441 \u043F\u043E\u0441\u0430\u0434\u044F\u0442 \u0437\u0430
      \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0441\u0442\u0435\u0440\u0435\u043E\u0442\u0438\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 15963550621626368
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u043F\u0435\u0446\u0438\u0438 \u0434\u043B\u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
      \u0431\u043B\u044E\u0434 \u0441\u043E \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 15963615608172544
    m_Localized: "\u0418\u043B\u0438 \u0442\u043E\u043C\u0430\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 15963005865422848
    m_Localized: "\u0415\u0441\u043B\u0438 \u0436\u0438\u0437\u043D\u044C \u0434\u0430\u043B\u0430
      \u0442\u0435\u0431\u0435 \u043B\u0438\u043C\u043E\u043D\u044B, \u043F\u0440\u043E\u0434\u0430\u0439
      \u0438\u0445 \u043D\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 15962861908520960
    m_Localized: "\u0410\u0434\u0441\u043A\u043E\u0435 \u043D\u0430\u0441\u043B\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 15963466278367232
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0435 \u0436\u0438\u0442\u0435\u043B\u0438
      \u0411\u0438\u043A\u0438\u043D\u0438 \u0422\u043E\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 15963580707368960
    m_Localized: "\u041D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u044F\u0442\u0438
      \u0433\u0440\u0430\u043C\u043C \u0432 \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 44338352591581184
