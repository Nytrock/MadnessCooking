      \u0438\u0445 \u0441 \u0443\u043C\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 37334141551095808
    m_Localized: "\u041D\u0443-\u0441, \u0434\u0443\u043C\u0430\u044E \u0441 \u044D\u0442\u0438\u043C
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C. \u041D\u0430
      \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0443 \u043D\u0430\u0441 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043B\u043E\u043A\u0430\u0446\u0438\u044F
      \u2014\_\u043E\u0444\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 37334164976283648
    m_Localized: "\u041F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0432 \u043E\u0444\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 37334186010718208
    m_Localized: "\u0422\u0443\u0442 \u043D\u0435 \u0442\u0430\u043A \u0443\u0436
      \u0438 \u043C\u043D\u043E\u0433\u043E \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0435\u0439,
      \u043D\u043E \u043E\u043D\u0438 \u043E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 37334210446733312
    m_Localized: "\u042D\u0442\u043E \u043C\u0430\u0442\u0440\u0430\u0441, \u043D\u0430
      \u043D\u0451\u043C \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u0430\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0431\u043E\u0434\u0440\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 37334227194589184
    m_Localized: "\u0411\u043E\u0434\u0440\u043E\u0441\u0442\u044C \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F
      \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0437\u0430
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0432 \u0438\u0433\u0440\u0435. \u0415\u0441\u043B\u0438 \u043D\u0435 \u0443\u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0441\u044E
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E, \u0432\u044B \u0443\u043F\u0430\u0434\u0451\u0442\u0435
      \u0432 \u043E\u0431\u043C\u043E\u0440\u043E\u043A (\u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 37334244315738112
    m_Localized: "\u042D\u0442\u043E \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
      \u0447\u0435\u0440\u0435\u0437 \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0439\u0442\u0438
      \u0432 \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0443\u043F\u0438\u0442\u044C \u043A\u0443\u0447\u0443 \u043D\u043E\u0432\u044B\u0445
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0430 \u043D\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 37334266268725248
    m_Localized: "\u0412 \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0435 \u0435\u0441\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 37334282785894400
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u043D\u043E\u0432\u044B\u0445
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u043E\u0432 \u0434\u043B\u044F
      \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u043D\u0438\u044F \u043D\u0430
      \u0444\u0435\u0440\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 37334298510340096
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0431\u043B\u044E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 37334316763951104
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0442\u0435\u0445\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 37334332937187328
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0439,
      \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445 \u0441
      \u0444\u0435\u0440\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 37334347768246272
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D \u0434\u0435\u043A\u043E\u0440\u0430.
      \u0414\u0435\u043A\u043E\u0440 \u043D\u0443\u0436\u0435\u043D \u0434\u043B\u044F
      \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0432\u0430\u0448\u0435\u0439
      \u0431\u043E\u0434\u0440\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 37334365866668032
    m_Localized: "\u0423\u0447\u0442\u0438\u0442\u0435, \u0447\u0442\u043E \u0442\u0443\u0442
      \u043E\u0447\u0435\u043D\u044C \u043F\u043B\u043E\u0445\u043E\u0439 \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442,
      \u0438 \u0438\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0436\u0434\u0430\u0442\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430
      (\u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u044D\u0442\u043E\u0442
      \u0444\u0430\u043A\u0442 \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043C)"
    m_Metadata:
      m_Items: []
  - m_Id: 37334385122717696
    m_Localized: "\u041F\u043E\u043A\u0438\u043D\u044C\u0442\u0435 \u0418\u043D\u0442\u0435\u0440\u043D\u0435\u0442"
