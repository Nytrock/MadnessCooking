  - m_Id: 70333816233984
    m_Localized: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 70449667104768
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u0433\u0440\u044F\u0434\u043A\u043E\u0439
      \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043B\u0435\u043D\u044B \u0432\u0441\u0435
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F. \u0414\u0435\u043D\u044C\u0433\u0438,
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0435 \u043D\u0430
      \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F, \u0431\u0443\u0434\u0443\u0442
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u044B \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
