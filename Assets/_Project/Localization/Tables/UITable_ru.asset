  - m_Id: 48022144802816
    m_Localized: "\u041A\u0440\u0438\u0442\u0438\u043A \u0433\u0440\u044F\u0434\u0451\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 48047621005312
    m_Localized: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0434\u043D\u044F \u043A \u0432\u0430\u043C \u0432 \u043A\u0430\u0444\u0435
      \u043F\u0440\u0438\u0434\u0451\u0442 \u043A\u0440\u0438\u0442\u0438\u043A.
      \u0412\u043D\u0435\u0448\u043D\u0435 \u043E\u043D \u043D\u0438\u0447\u0435\u043C
      \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u043A\u043B\u0438\u0435\u043D\u0442\u0430,
      \u043D\u043E \u0435\u0441\u043B\u0438 \u0432\u044B \u0443\u0441\u043F\u0435\u0448\u043D\u043E
      \u0435\u0433\u043E \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0442\u0435,
      \u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438. \u0412
      \u0441\u043B\u0443\u0447\u0430\u0435 \u043D\u0435\u0443\u0434\u0430\u0447\u0438
      \u0432\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442\u0435 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u043F\u044B\u0442\u0430.
      \u0423\u0447\u0442\u0438\u0442\u0435, \u0447\u0442\u043E \u043A\u0440\u0438\u0442\u0438\u043A
      \u043F\u0440\u0438\u0434\u0451\u0442 \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 48065874616320
    m_Localized: "\u0412\u044B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u043B\u0438
      \u043A\u0440\u0438\u0442\u0438\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 48083239034880
    m_Localized: "\u0417\u0430 \u044D\u0442\u043E \u0432\u044B \u043F\u0435\u0440\u0435\u0448\u043B\u0438
      \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 48112599162880
    m_Localized: "\u0412\u044B \u043D\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u043B\u0438
      \u043A\u0440\u0438\u0442\u0438\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 48157637599232
    m_Localized: "\u0418\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E \u0432\u044B
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043C\u043D\u043E\u0433\u043E
      \u043E\u043F\u044B\u0442\u0430! \u041D\u043E \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C,
      \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439 \u043E\u043F\u044B\u0442,
      \u043A\u0440\u0438\u0442\u0438\u043A \u043F\u0440\u0438\u0434\u0451\u0442 \u0432\u043D\u043E\u0432\u044C
      \u0438 \u0443 \u0432\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0451
      \u043E\u0434\u0438\u043D \u0448\u0430\u043D\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 54924543123456
    m_Localized: "\u041E\u0427\u0415\u041D\u042C \u0421\u0427\u0410\u0421\u0422\u041B\u0418\u0412\u042B\u0419
