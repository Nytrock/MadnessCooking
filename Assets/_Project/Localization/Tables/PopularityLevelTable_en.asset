  m_TableData:
  - m_Id: 456443319762944
    m_Localized: No one knows about you
    m_Metadata:
      m_Items: []
  - m_Id: 15974722209050624
    m_Localized: Rumors have started spreading about your establishment
    m_Metadata:
      m_Items: []
  - m_Id: 15974768694521856
    m_Localized: The first regular customers have appeared
    m_Metadata:
      m_Items: []
  - m_Id: 15974793084399616
    m_Localized: Local residents visit you regularly
    m_Metadata:
      m_Items: []
  - m_Id: 15974823929311232
    m_Localized: The best cafe in the neighborhood.
    m_Metadata:
      m_Items: []
  - m_Id: 15974864953798656
    m_Localized: Your cafe was featured on the local news
    m_Metadata:
      m_Items: []
  - m_Id: 15974893592506368
    m_Localized: People from all around are flocking to your cafe
    m_Metadata:
      m_Items: []
  - m_Id: 15974915583242240
    m_Localized: The city administration has taken an interest in you
    m_Metadata:
      m_Items: []
  - m_Id: 15974940816175104
    m_Localized: The mayor presented you with the key to the city
    m_Metadata:
      m_Items: []
  - m_Id: 15974975784087552
    m_Localized: The best cafe in the city
    m_Metadata:
      m_Items: []
  - m_Id: 15975013092421632
    m_Localized: People from other cities have started to hear about you
    m_Metadata:
      m_Items: []
  - m_Id: 15975054154657792
    m_Localized: The cafe has started to be included in tourist itineraries across
      the country
    m_Metadata:
      m_Items: []
  - m_Id: 15975078947188736
    m_Localized: 'The deputies expressed their opinion about the cafe: "Great place!
      The lemonade is especially good!"'
    m_Metadata:
      m_Items: []
  - m_Id: 15975104209481728
    m_Localized: The president of the country personally had breakfast at your cafe
    m_Metadata:
      m_Items: []
  - m_Id: 15975129454997504
    m_Localized: The best cafe in the country
    m_Metadata:
      m_Items: []
  - m_Id: 15975154172030976
    m_Localized: Your cafe is starting to gain recognition abroad
    m_Metadata:
      m_Items: []
  - m_Id: 15975175831416832
    m_Localized: Tourists are coming to you from all over the world
    m_Metadata:
      m_Items: []
  - m_Id: 15975199713783808
    m_Localized: World-class stars are dining at your cafe
    m_Metadata:
      m_Items: []
  - m_Id: 15975222061035520
    m_Localized: International negotiations are held at your cafe
    m_Metadata:
      m_Items: []
  - m_Id: 15975249626001408
