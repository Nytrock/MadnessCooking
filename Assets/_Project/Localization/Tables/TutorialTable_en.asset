%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: c063c487290192b418d6ea4643b99a60, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 37616324564070400
    m_Localized: 'My advice for the future: repairing partially broken equipment
      is much cheaper than repairing completely broken equipment'
    m_Metadata:
      m_Items: []
  - m_Id: 37653290617778176
    m_Localized: This is the place for chickens. After obtaining them in the future,
      you will be able to feed them, and in return, they will give you eggs
    m_Metadata:
      m_Items: []
  - m_Id: 37992156851712000
    m_Localized: This is the "Home" button, which takes you back to the main page
      (meaning this one)
    m_Metadata:
      m_Items: []
  - m_Id: 37621889109438464
    m_Localized: Thank God!
    m_Metadata:
      m_Items: []
  - m_Id: 37332689143312384
    m_Localized: Welcome to the incredible, amazing, and delightful game Madness
      Cooking!
    m_Metadata:
      m_Items: []
  - m_Id: 37332724123807744
    m_Localized: "If you want, you can call me a guardian angel (but better not,
      I don\u2019t want trouble with the church)"
    m_Metadata:
      m_Items: []
  - m_Id: 37332707476615168
    m_Localized: I am your invisible assistant in this adventure
    m_Metadata:
      m_Items: []
  - m_Id: 37332740167020544
    m_Localized: "Let\u2019s start by understanding how the cafe is organized"
    m_Metadata:
      m_Items: []
  - m_Id: 37332756604497920
    m_Localized: "Let\u2019s start with the arrangement of the tables"
    m_Metadata:
      m_Items: []
  - m_Id: 37332774396735488
    m_Localized: Close the cafe to rearrange the tables
    m_Metadata:
      m_Items: []
  - m_Id: 37332790439948288
    m_Localized: Click on the box to enter edit mode
    m_Metadata:
      m_Items: []
  - m_Id: 37332808827777024
    m_Localized: Click the plus button to add a table (it's free)
    m_Metadata:
      m_Items: []
  - m_Id: 37332823390400512
    m_Localized: Select a table with 1 seat
    m_Metadata:
      m_Items: []
  - m_Id: 37332838670249984
    m_Localized: Add a table
    m_Metadata:
      m_Items: []
  - m_Id: 37332852813443072
    m_Localized: Turn off edit mode
    m_Metadata:
      m_Items: []
  - m_Id: 37332869221560320
    m_Localized: "Great! I\u2019m sure you\u2019ll figure out where to place more
      tables later"
    m_Metadata:
      m_Items: []
  - m_Id: 37332889815592960
    m_Localized: Well then, we have a table, time to start welcoming customers!
    m_Metadata:
      m_Items: []
  - m_Id: 37553991712092160
    m_Localized: The frequency of customer arrivals depends on many factors, such
      as the number of dishes or the time of day
    m_Metadata:
      m_Items: []
  - m_Id: 37332907465224192
    m_Localized: Open the cafe
    m_Metadata:
      m_Items: []
  - m_Id: 37332922849931264
    m_Localized: "Wait for the customer to sit at the table. I\u2019ve intentionally
      locked the screen for this time so you don\u2019t try to softlock yourself"
    m_Metadata:
      m_Items: []
  - m_Id: 37332966231617536
    m_Localized: Click on the panel above the customer to see which dish they want
    m_Metadata:
      m_Items: []
  - m_Id: 37333000096428032
    m_Localized: Go to the kitchen
    m_Metadata:
      m_Items: []
  - m_Id: 37332983642173440
    m_Localized: "The person wants lemonade... Well, let\u2019s not deny them!"
    m_Metadata:
      m_Items: []
  - m_Id: 37333073291227136
    m_Localized: In the kitchen (wow), dishes are being prepared
    m_Metadata:
      m_Items: []
  - m_Id: 37333092182372352
    m_Localized: The ingredients for the dishes are in the drawer. You can view them
      by left-clicking on the drawer
    m_Metadata:
      m_Items: []
  - m_Id: 37333165674967040
    m_Localized: Click on the blender
    m_Metadata:
      m_Items: []
  - m_Id: 37333114571567104
    m_Localized: "he only kitchen appliance you have right now is a broken blender.
      Let\u2019s make it less broken!"
    m_Metadata:
      m_Items: []
  - m_Id: 37333186084450304
    m_Localized: Click on the icon to repair the appliance
    m_Metadata:
      m_Items: []
  - m_Id: 37333207982911488
    m_Localized: "Great! We\u2019re lucky that the blender was just unplugged, and
      the repair took only a second"
    m_Metadata:
      m_Items: []
  - m_Id: 37333246390153216
    m_Localized: "Well then, let\u2019s finally start preparing the order!"
    m_Metadata:
      m_Items: []
  - m_Id: 37333264782176256
    m_Localized: Click on the counter to view all customer orders
    m_Metadata:
      m_Items: []
  - m_Id: 37333281127378944
    m_Localized: Each order card displays the dish, required ingredients and equipment,
      and the table number
    m_Metadata:
      m_Items: []
  - m_Id: 37333295966826496
    m_Localized: Start preparing the dish
    m_Metadata:
      m_Items: []
  - m_Id: 37333312895037440
    m_Localized: Wait for it to be cooked
    m_Metadata:
      m_Items: []
  - m_Id: 37333329538035712
    m_Localized: "Well, that\u2019s a relief, no fatalities this time!"
    m_Metadata:
      m_Items: []
  - m_Id: 37333358709420032
    m_Localized: Return to the cafe
    m_Metadata:
      m_Items: []
  - m_Id: 37333381216055296
    m_Localized: Click on the customer's order
    m_Metadata:
      m_Items: []
  - m_Id: 37333398655971328
    m_Localized: Click "Yes" to deliver the order
    m_Metadata:
      m_Items: []
  - m_Id: 37333429681238016
    m_Localized: For completed orders, you earn money and reputation
    m_Metadata:
      m_Items: []
  - m_Id: 37333415219277824
    m_Localized: After the customer receives the order, they eat it for a while and
      then leave
    m_Metadata:
      m_Items: []
  - m_Id: 37333466784051200
    m_Localized: 'An important note about groups: if you serve one from the group,
      the rest will wait until the end of time'
    m_Metadata:
      m_Items: []
  - m_Id: 37333450963136512
    m_Localized: Reputation increases your popularity level, which causes customers
      to start arriving in groups
    m_Metadata:
      m_Items: []
  - m_Id: 37333484219772928
    m_Localized: "Now, let\u2019s figure out where to get the ingredients for the
      orders"
    m_Metadata:
      m_Items: []
  - m_Id: 37333518860529664
    m_Localized: Go to the farm
    m_Metadata:
      m_Items: []
  - m_Id: 37333535277035520
    m_Localized: At the farm, ingredients for the dishes are grown and then sent
      to the kitchen by car
    m_Metadata:
      m_Items: []
  - m_Id: 37333556206612480
    m_Localized: This is the barn; you can enter it by left-clicking on it. Do that
      NOW
    m_Metadata:
      m_Items: []
  - m_Id: 37333571096391680
    m_Localized: "There isn\u2019t much available here for now"
    m_Metadata:
      m_Items: []
  - m_Id: 37333589496803328
    m_Localized: Composter. As ingredients are collected, it slowly fills up, providing
      fertilizers when completely filled. Fertilizers are used to speed up growth
      in the garden bed
    m_Metadata:
      m_Items: []
  - m_Id: 37333612443840512
    m_Localized: Refrigerator. In the future, milk and flour will be stored here.
      To transfer them to the car, you need to left-click on the refrigerator first,
      and then on the corresponding icon
    m_Metadata:
      m_Items: []
  - m_Id: 37652931623104512
    m_Localized: This is the place for the cow. You will be able to get it later,
      and it will give milk in exchange for wheat
    m_Metadata:
      m_Items: []
  - m_Id: 37653087785431040
    m_Localized: "This is the mill. It\u2019s broken for now, but once you repair
      it, you\u2019ll be able to get flour from wheat"
    m_Metadata:
      m_Items: []
  - m_Id: 37333628411555840
    m_Localized: "Exit the barn, there\u2019s not much to do here for now"
    m_Metadata:
      m_Items: []
  - m_Id: 37333645796945920
    m_Localized: This is the store, where you can buy various upgrades for the farm
    m_Metadata:
      m_Items: []
  - m_Id: 37333665933799424
    m_Localized: "This is the well. Once it\u2019s unlocked, you\u2019ll be able
      to collect water from it to irrigate the garden beds"
    m_Metadata:
      m_Items: []
  - m_Id: 37333687840649216
    m_Localized: "It\u2019s farmin time! Click the plus button to place a garden
      bed"
    m_Metadata:
      m_Items: []
  - m_Id: 37333741645180928
    m_Localized: Select a regular garden bed
    m_Metadata:
      m_Items: []
  - m_Id: 37333756606263296
    m_Localized: Click "Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 37333806275211264
    m_Localized: Click "Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 37333773635137536
    m_Localized: '

      Click on the garden bed to plant something on it'
    m_Metadata:
      m_Items: []
  - m_Id: 37333792459173888
    m_Localized: Select lemon
    m_Metadata:
      m_Items: []
  - m_Id: 37333825510289408
    m_Localized: Click on the garden bed to open the menu
    m_Metadata:
      m_Items: []
  - m_Id: 37333935120035840
    m_Localized: These buttons for watering and fertilizing the garden bed are used
      to speed up plant growth. Fertilizers are taken from the composter, and water
      will be unlocked in the future along with the well
    m_Metadata:
      m_Items: []
  - m_Id: 37333954334142464
    m_Localized: Bugs slowly but surely appear on the garden bed. Click this button
      to remove them
    m_Metadata:
      m_Items: []
  - m_Id: 37333971346239488
    m_Localized: This is the button to add upgrades to the garden bed
    m_Metadata:
      m_Items: []
  - m_Id: 37685913998176256
    m_Localized: This is the button to transplant the plant on the garden bed
    m_Metadata:
      m_Items: []
  - m_Id: 37334017718464512
    m_Localized: This is the button to remove the garden bed
    m_Metadata:
      m_Items: []
  - m_Id: 37334060059963392
    m_Localized: (Almost) all collected ingredients go into the car
    m_Metadata:
      m_Items: []
  - m_Id: 37334044687839232
    m_Localized: To collect an ingredient from the garden bed, simply click on its
      icon
    m_Metadata:
      m_Items: []
  - m_Id: 37334084923797504
    m_Localized: The exception is wheat, which in the future will be used to obtain
      milk and flour
    m_Metadata:
      m_Items: []
  - m_Id: 37334105245200384
    m_Localized: o send the car, first click on it, then click the send button
    m_Metadata:
      m_Items: []
  - m_Id: 37334124316700672
    m_Localized: "Keep in mind that there\u2019s a significant amount of time between
      sending the car, so make sure to send it wisely"
    m_Metadata:
      m_Items: []
  - m_Id: 37334141551095808
    m_Localized: "Well, I think we\u2019ve got this figured out. The last location
      we need to cover is the office"
    m_Metadata:
      m_Items: []
  - m_Id: 37334164976283648
    m_Localized: Go to the office
    m_Metadata:
      m_Items: []
  - m_Id: 37334186010718208
    m_Localized: "There aren\u2019t many activities here, but they are very important"
    m_Metadata:
      m_Items: []
  - m_Id: 37334210446733312
    m_Localized: This is a mattress, where you can sleep to restore energy
    m_Metadata:
      m_Items: []
  - m_Id: 37334227194589184
    m_Localized: "Energy is consumed with almost every action in the game. If you
      don\u2019t manage it and run out of energy, you will faint (not recommended)"
    m_Metadata:
      m_Items: []
  - m_Id: 37334244315738112
    m_Localized: This is a computer, through which you can access the Internet to
      buy a bunch of new items. Click on it
    m_Metadata:
      m_Items: []
  - m_Id: 37334266268725248
    m_Localized: There are several themed stores on the Internet
    m_Metadata:
      m_Items: []
  - m_Id: 37334282785894400
    m_Localized: A store for new ingredients to grow on the farm
    m_Metadata:
      m_Items: []
  - m_Id: 37334298510340096
    m_Localized: '

      A store for dishes'
    m_Metadata:
      m_Items: []
  - m_Id: 37334332937187328
    m_Localized: A store for non-farm-related upgrades
    m_Metadata:
      m_Items: []
  - m_Id: 37334316763951104
    m_Localized: A store for equipment
    m_Metadata:
      m_Items: []
  - m_Id: 37334347768246272
    m_Localized: A store for decor. Decor is needed to boost your energy
    m_Metadata:
      m_Items: []
  - m_Id: 37334385122717696
    m_Localized: Leave the Internet
    m_Metadata:
      m_Items: []
  - m_Id: 37334365866668032
    m_Localized: "Keep in mind that the Internet here is very slow, so you\u2019ll
      have to wait for each store to load (this issue can be fixed in the future)"
    m_Metadata:
      m_Items: []
  - m_Id: 37334399966359552
    m_Localized: Return to the cafe
    m_Metadata:
      m_Items: []
  - m_Id: 37334415980212224
    m_Localized: "You\u2019re almost there! Come up with a name for your cafe"
    m_Metadata:
      m_Items: []
  - m_Id: 37334434057662464
    m_Localized: "You can hover the cursor over the caf\xE9 name to see its current
      popularity level and its characteristics"
    m_Metadata:
      m_Items: []
  - m_Id: 37334458321711104
    m_Localized: You can also click on the name to change it
    m_Metadata:
      m_Items: []
  - m_Id: 37334474587222016
    m_Localized: "That\u2019s all, enjoy the game!"
    m_Metadata:
      m_Items: []
  - m_Id: 37555104167342080
    m_Localized: Okay
    m_Metadata:
      m_Items: []
  - m_Id: 37557000261185536
    m_Localized: Hello
    m_Metadata:
      m_Items: []
  - m_Id: 37557040593612800
    m_Localized: Oh, God...
    m_Metadata:
      m_Items: []
  - m_Id: 37594944002961408
    m_Localized: Of course not!
    m_Metadata:
      m_Items: []
  - m_Id: 37608946166771712
    m_Localized: Let's do it!
    m_Metadata:
      m_Items: []
  - m_Id: 37617960334241792
    m_Localized: Finally...
    m_Metadata:
      m_Items: []
  - m_Id: 38049174903959552
    m_Localized: One moment...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
